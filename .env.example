# --- 应用 ---
APP_NAME=企业知识库智能问答助手
DEBUG=false
ENABLE_AUTH=false
API_KEYS=
ADMIN_API_KEYS=

# --- 数据库 ---
# 本机开发使用 localhost；Docker Compose 会自动覆盖为 db 主机
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5432/assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
AUTO_CREATE_TABLES=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 文件存储 ---
STORAGE_DIR=./data/documents

# --- Embedding ---
# provider: openai | dummy
# 可切换任意 OpenAI 兼容模型，例如 text-embedding-v4、bge-m3、text-embedding-3-large 等
# EMBEDDING_DIM 必须等于模型实际输出维度；切换后运行:
#   python backend/scripts/reembed_cli.py --recreate-table
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxx

# --- LLM ---
# provider: openai | dummy
# LLM_MODEL 可改为任意 OpenAI 兼容模型，如 deepseek-chat、qwen-plus、glm-4、本地 Ollama 模型等
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_TEMPERATURE=0.2

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=6
RERANK_TOP_K=4
RERANKER_PROVIDER=rrf
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# --- 前端 CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
